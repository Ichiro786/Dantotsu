<resources>

    <style name="Widget.Dantotsu.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.Dantotsu.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Material 3 Expressive controls (MDC 1.14) -->
    <style name="Widget.Dantotsu.Slider" parent="Widget.Material3.Slider" />

    <!-- Player brightness / volume (rotated 270): expressive small track with a bar handle. -->
    <style name="Widget.Dantotsu.Slider.PlayerVertical" parent="Widget.Material3Expressive.Slider.Small">
        <item name="labelBehavior">gone</item>
    </style>

    <style name="Widget.Dantotsu.LoadingIndicator" parent="Widget.Material3.LoadingIndicator" />
</resources>
