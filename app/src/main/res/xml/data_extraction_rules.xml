<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer: never copy account tokens or the app password -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="ani.dantotsu.protected.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="ani.dantotsu.protected.xml" />
    </device-transfer>
</data-extraction-rules>
